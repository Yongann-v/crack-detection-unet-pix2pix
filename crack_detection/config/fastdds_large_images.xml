<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for large raw images (e.g. /crack_detection/visualization, ~5 MB/frame).
  The default shared-memory segment (512 KB) is far too small, so big frames get
  fragmented and best-effort subscribers (rqt_image_view, ros2 topic hz) lose them.
  UDPv4 is kept so topics from the robot over the network still work.

  Only the publishing node needs it; crack_detection.launch.py sets
  FASTRTPS_DEFAULT_PROFILES_FILE for the detector node. Viewers work unchanged.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size> <!-- 64 MB -->
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
